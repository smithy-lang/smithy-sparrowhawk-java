<FindBugsFilter>
    <!-- Ignore all test files. -->
    <Match>
        <Class name="~Test\.java$"/>
    </Match>

    <!-- Excessive Defensive copies. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Excessive Defensive checks on constructor exceptions. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Suppress all findings for sparrowhawk-types files that use low-level serialization patterns. -->
    <Match>
        <Source name="BigDecimalHolder.java"/>
    </Match>
    <Match>
        <Source name="SparrowhawkSerializer.java"/>
    </Match>
    <Match>
        <Source name="SparrowhawkDeserializer.java"/>
    </Match>
    <Match>
        <Source name="OptionalBlob.java"/>
    </Match>
    <Match>
        <Source name="OptionalObject.java"/>
    </Match>
</FindBugsFilter>
